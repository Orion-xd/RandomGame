--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f3c7eceec3c58bb4ca19f5e1fb59392b, type: 3}
  m_Name: Prologue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  pages:
  - speaker: 0
    expression: 0
    text: "\u3053\u3053\u306F\u7570\u4E16\u754C\u3001\u9B54\u7269\u304C\u6F5C\u3080\u8857"
    fontSize: 45
    image: {fileID: 0}
    playerSpriteOverride: {fileID: 0}
    layout: 0
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 0
    expression: 0
    text: "\u3042\u308B\u65E5\u3001\u8857\u306E\u306F\u305A\u308C\u306B\u3001\u7A81\u5982\u30C0\u30F3\u30B8\u30E7\u30F3\u304C\u51FA\u73FE\u3057\u305F"
    fontSize: 45
    image: {fileID: 0}
    playerSpriteOverride: {fileID: 0}
    layout: 0
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 0
    expression: 0
    text: "\u9B54\u7269\u304B\u3089\u8857\u3092\u5B88\u308B\u305F\u3081\u3001\u591A\u304F\u306E\u52C7\u8005\u304C\u30C0\u30F3\u30B8\u30E7\u30F3\u653B\u7565\u3078\u3068\u5411\u304B\u3063\u305F"
    fontSize: 45
    image: {fileID: 0}
    playerSpriteOverride: {fileID: 0}
    layout: 0
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 0
    expression: 0
    text: "\u3057\u304B\u3057\u3001\u5E30\u3063\u3066\u304D\u305F\u8005\u306F\u3001\u8AB0\u4E00\u4EBA\u3068\u3057\u3066\u3044\u306A\u304B\u3063\u305F\u2026"
    fontSize: 45
    image: {fileID: 0}
    playerSpriteOverride: {fileID: 0}
    layout: 0
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 0
    expression: 0
    text: "\u305D\u3093\u306A\u4E2D\u3001\u7ACB\u3061\u4E0A\u304C\u3063\u305F\u306E\u306F\u3001\u4E16\u754C\u6700\u5F37\u306E\u52C7\u8005\u30FC\u30FC"
    fontSize: 45
    image: {fileID: 0}
    playerSpriteOverride: {fileID: 0}
    layout: 0
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 0
    expression: 0
    text: "\u305D\u306E\u540D\u3082\u3001\u52C7\u8005\u3057\u3070\u308A\u3061\u3083\u3093\u3067\u3042\u308B\uFF01"
    fontSize: 45
    image: {fileID: 0}
    playerSpriteOverride: {fileID: 0}
    layout: 0
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 1
    expression: 11
    text: "\u2026\u3053\u3053\u304C\u884C\u65B9\u4E0D\u660E\u8005\u304C\u591A\u767A\u3057\u3066\u3044\u308B\u30C0\u30F3\u30B8\u30E7\u30F3\u306D"
    fontSize: 45
    image: {fileID: 9046660648462993162, guid: 5004db2134ee3ee4aa29cd48d200771f, type: 3}
    playerSpriteOverride: {fileID: 0}
    layout: 1
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 1
    expression: 11
    text: "\u306A\u3093\u3060\u304B\u5384\u4ECB\u306A\u30C0\u30F3\u30B8\u30E7\u30F3\u3060\u3063\u3066\u5642\u3060\u3051\u3069\u2026"
    fontSize: 45
    image: {fileID: 9046660648462993162, guid: 5004db2134ee3ee4aa29cd48d200771f, type: 3}
    playerSpriteOverride: {fileID: 0}
    layout: 1
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 1
    expression: 11
    text: "\u3053\u306E\u79C1\u3001\u52C7\u8005\u3057\u3070\u308A\u3061\u3083\u3093\u304C\u6765\u305F\u304B\u3089\u306B\u306F\u2026"
    fontSize: 45
    image: {fileID: 9046660648462993162, guid: 5004db2134ee3ee4aa29cd48d200771f, type: 3}
    playerSpriteOverride: {fileID: 0}
    layout: 1
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 1
    expression: 3
    text: "\u3069\u3093\u306A\u30AF\u30A8\u30B9\u30C8\u3060\u3063\u3066\u83EF\u9E97\u306B\u30AF\u30EA\u30A2\u3057\u3066\u307F\u305B\u308B\u308F\uFF01\uFF01\n\u898B\u3066\u306A\u3055\u3044\u301C\u301C\uFF01"
    fontSize: 40
    image: {fileID: 9046660648462993162, guid: 5004db2134ee3ee4aa29cd48d200771f, type: 3}
    playerSpriteOverride: {fileID: 0}
    layout: 1
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
