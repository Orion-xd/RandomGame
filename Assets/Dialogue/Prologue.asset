  m_Script: {fileID: 11500000, guid: f3c7eceec3c58bb4ca19f5e1fb59392b, type: 3}
  m_Name: Prologue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  pages:
  - speaker: 
    text: "\u3042\u308B\u65E5\u3001\u8857\u306E\u5916\u308C\u306B\u30C0\u30F3\u30B8\u30E7\u30F3\u304C\u51FA\u73FE\u3057\u305F\u3002"
    image: {fileID: 0}
    layout: 0
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 
    text: "\u305D\u306E\u30C0\u30F3\u30B8\u30E7\u30F3\u3078\u5411\u304B\u3063\u305F\u52C7\u8005\u306F\u7686\u5E30\u3063\u3066\u3053\u306A\u304B\u3063\u305F\u3002"
    image: {fileID: 0}
    layout: 0
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 
    text: "\u30AE\u30EB\u30C9\u306F\u4E16\u754C\u6700\u5F37\u306E\u52C7\u8005\u3057\u3070\u308A\u3061\u3083\u3093\u3092\u30C0\u30F3\u30B8\u30E7\u30F3\u3078\u3068\u5411\u304B\u308F\u305B\u305F\u3002"
    image: {fileID: 0}
    layout: 0
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: "\u52C7\u8005"
    text: "\u3053\u3053\u304C\u884C\u65B9\u4E0D\u660E\u8005\u304C\u591A\u767A\u3057\u3066\u3044\u308B\u30C0\u30F3\u30B8\u30E7\u30F3\u306E\u3088\u3046\u306D"
    image: {fileID: 0}
    layout: 1
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: "\u52C7\u8005"
    text: "\u7686\u7121\u4E8B\u3060\u3068\u3044\u3044\u3051\u308C\u3069"
    image: {fileID: 0}
    layout: 1
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: "\u52C7\u8005"
    text: "\u65E9\u901F\u4E2D\u306B\u5165\u308D\u3046\u304B\u3057\u3089"
    image: {fileID: 0}
    layout: 1
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
