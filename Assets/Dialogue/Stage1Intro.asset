  pages:
  - speaker: 1
    expression: 11
    text: "\u2026\u4F55\u3088\u3002\u666E\u901A\u306E\u30C0\u30F3\u30B8\u30E7\u30F3\u3058\u3083\u306A\u3044"
    fontSize: 45
    image: {fileID: 0}
    playerSpriteOverride: {fileID: 5024734127510466783, guid: 7160cf65c3547b443af6c6a09e649dd8, type: 3}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 1
    expression: 13
    text: "\u3042\u3001\u3042\u308C\u2026\u6025\u306B\u2026\u7720\u6C17\u304C\u2026\u2026"
    fontSize: 45
    image: {fileID: 0}
    playerSpriteOverride: {fileID: 5024734127510466783, guid: 7160cf65c3547b443af6c6a09e649dd8, type: 3}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 1
    expression: 13
    text: .........
    fontSize: 45
    image: {fileID: 0}
    playerSpriteOverride: {fileID: 5024734127510466783, guid: 7160cf65c3547b443af6c6a09e649dd8, type: 3}
    layout: 0
    useTypewriterEffect: 0
    typewriterCharsPerSecond: 30
  - speaker: 1
    expression: 14
    text: "\u304E\u3083\u30FC\u30FC\u30FC\u30FC\u30FC\uFF01\uFF1F\uFF01\uFF1F"
    fontSize: 45
    image: {fileID: 0}
    playerSpriteOverride: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 1
    expression: 14
    text: "\u306A\u306A\u306A\u306A\u4F55\u3053\u308C\uFF01\uFF1F\u4F53\u306B\u9396\u304C\u2026\u52D5\u3051\u306A\u3044\uFF01\uFF1F"
    fontSize: 45
    image: {fileID: 0}
    playerSpriteOverride: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 1
    expression: 8
    text: "\u306A\u3001\u306A\u3093\u3068\u304B\u89E3\u9664\u3059\u308B\u65B9\u6CD5\u3092\u898B\u3064\u3051\u306A\u304F\u3061\u3083\u2026\uFF01"
    fontSize: 45
    image: {fileID: 0}
    playerSpriteOverride: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 0
    expression: 0
    text: "\u3057\u3070\u308A\u3061\u3083\u3093\u3068\u4E00\u7DD2\u306B\u3001\u546A\u3044\u306E\u30C0\u30F3\u30B8\u30E7\u30F3\u3092\n\u653B\u7565\u3057\u3088\u3046"
    fontSize: 45
    image: {fileID: 0}
    playerSpriteOverride: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 0
    expression: 0
    text: "A\u30FBD\u3067\u79FB\u52D5\u3057\u3088\u3046"
    fontSize: 45
    image: {fileID: 0}
    playerSpriteOverride: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 0
    expression: 0
    text: "SPACE\u3067\u30A2\u30AF\u30B7\u30E7\u30F3\u3092\u767A\u52D5\u3067\u304D\u308B"
    fontSize: 45
    image: {fileID: 0}
    playerSpriteOverride: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 0
    expression: 0
    text: "\u3057\u3070\u308A\u3061\u3083\u3093\u306F\u546A\u3044\u306B\u3088\u308A\u6C7A\u307E\u3063\u305F\u30A2\u30AF\u30B7\u30E7\u30F3\u3057\u304B\n\u767A\u52D5\u3067\u304D\u306A\u3044"
    fontSize: 45
    image: {fileID: 0}
    playerSpriteOverride: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 0
    expression: 0
    text: "\u4E0B\u306E\u30D0\u30FC\u306E\u4E00\u756A\u5DE6\u306E\u30A2\u30AF\u30B7\u30E7\u30F3\u304C\u6B21\u306B\u767A\u52D5\u3059\u308B\n\u30A2\u30AF\u30B7\u30E7\u30F3\u3067\u3042\u308B"
    fontSize: 45
    image: {fileID: 0}
    playerSpriteOverride: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 0
    expression: 0
    text: "\u4E00\u5EA6\u30A2\u30AF\u30B7\u30E7\u30F3\u3092\u4F7F\u3046\u3068\u4E00\u3064\u53F3\u306E\u30A2\u30AF\u30B7\u30E7\u30F3\u3092\n\u767A\u52D5\u3067\u304D\u308B"
    fontSize: 45
    image: {fileID: 0}
    playerSpriteOverride: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 0
    expression: 0
    text: "\u307E\u305A\u306FSPACE\u3067\u30C0\u30C3\u30B7\u30E5\u3057\u3066\u307F\u3088\u3046"
    fontSize: 45
    image: {fileID: 0}
    playerSpriteOverride: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
