    typewriterCharsPerSecond: 30
  - speaker: "\u52C7\u8005"
    text: "\u546A\u3044\u306E\u3088\u3046\u3060"
    image: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: "\u52C7\u8005"
