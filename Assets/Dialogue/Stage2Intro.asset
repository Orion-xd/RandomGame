    layout: 2
  - speaker: "\u52C7\u8005"
    text: "\u4ED5\u65B9\u306A\u3044\u3001\u3053\u308C\u3067\u30C0\u30F3\u30B8\u30E7\u30F3\u3092\u653B\u7565\u3057\u307E\u3057\u3087\u3046"
