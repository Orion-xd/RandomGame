    text: "\u306A\u3093\u3068\u304B\u5263\u3092\u4F7F\u3048\u305D\u3046\u306D"
    image: {fileID: 0}
    layout: 2
  - speaker: "\u52C7\u8005"
    text: "\u3067\u3082\u3001\u81EA\u7531\u306B\u884C\u52D5\u304C\u3067\u304D\u306A\u3044\u307F\u305F\u3044"
    image: {fileID: 0}
    layout: 2
  - speaker: "\u52C7\u8005"
    text: "SPACE\u3067\u6C7A\u3081\u3089\u308C\u305F\u30A2\u30AF\u30B7\u30E7\u30F3\u304C\u3067\u304D\u308B\u3088\u3046\u306D"
