--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f3c7eceec3c58bb4ca19f5e1fb59392b, type: 3}
  m_Name: Stage4Intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  pages:
  - speaker: 2
    expression: 1
    text: "\u6570\u591A\u306E\u8A66\u7DF4\u3092\u4E57\u308A\u8D8A\u3048\u3057\u3001\u52C7\u8005\u3057\u3070\u308A\u3061\u3083\u3093\u3088\u2026\n\u3088\u304F\u305E\u3053\u3053\u307E\u3067\u8FBF\u308A\u7740\u3044\u305F"
    fontSize: 45
    image: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 1
    expression: 6
    text: "\u304A\u524D\u304B\u30FC\uFF01\uFF01\uFF01\n\u79C1\u306B\u546A\u3044\u3092\u304B\u3051\u305F\u306E\u306F\u30FC\uFF01\uFF01"
    fontSize: 75
    image: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 2
    expression: 5
    text: "\u2026\u2026\u2026\u2026\u3048\u3063"
    fontSize: 45
    image: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 2
    expression: 1
    text: "\u2026\u305D\u3046\u3060"
    fontSize: 45
    image: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 1
    expression: 6
    text: "\u30C0\u30F3\u30B8\u30E7\u30F3\u306B\u5165\u3063\u305F\u4ED6\u306E\u5192\u967A\u8005\u305F\u3061\u3082\u8FD4\u305B\u30FC\uFF01"
    fontSize: 45
    image: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 2
    expression: 1
    text: "\u305D\u3053\u3067\u62D8\u675F\u3057\u3066\u3044\u308B"
    fontSize: 45
    image: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 1
    expression: 10
    text: "\u8FD4\u3057\u3066\u3061\u3087\u3046\u3060\u3044"
    fontSize: 45
    image: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 2
    expression: 1
    text: "\u7121\u7406\u306A\u9858\u3044\u3060\u2026\u5F7C\u3089\u306F\u6211\u304C\u529B\u306E\u6E90"
    fontSize: 45
    image: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 2
    expression: 1
    text: "\u2026\u3086\u3048\u306B\u3001\u3042\u305D\u3053\u306B\u62D8\u675F\u3057\u3066\u3044\u308B"
    fontSize: 45
    image: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 2
    expression: 1
    text: "\u4ECA\u3059\u3050\u30C0\u30F3\u30B8\u30E7\u30F3\u3092\u7ACB\u3061\u53BB\u308B\u306E\u306A\u3089\u3001\n\u304A\u524D\u306E\u546A\u3044\u3060\u3051\u306F\u89E3\u3044\u3066\u3084\u308D\u3046\u2026"
    fontSize: 45
    image: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 1
    expression: 10
    text: "\u56DA\u308F\u308C\u305F\u4EBA\u305F\u3061\u3092\u89E3\u653E\u3059\u308B\u6C17\u306F\u306A\u3044\u306E\u304B\u3057\u3089\uFF1F"
    fontSize: 45
    image: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 2
    expression: 1
    text: "\u306A\u3044"
    fontSize: 45
    image: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 1
    expression: 10
    text: "\u3075\u3093\u2026\u2026"
    fontSize: 45
    image: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 1
    expression: 0
    text: "\u3044\u3044\u5EA6\u80F8\u3088\uFF01"
    fontSize: 45
    image: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
  - speaker: 1
    expression: 2
    text: "\u3053\u306E\u52C7\u8005\u3057\u3070\u308A\u3061\u3083\u3093\u304C\uFF01\n\u3042\u306A\u305F\u3092\u83EF\u9E97\u306B\u6253\u3061\u8CA0\u304B\u3057\u3066\u3042\u3052\u308B\u308F\uFF01\uFF01"
    fontSize: 45
    image: {fileID: 0}
    layout: 2
    useTypewriterEffect: 1
    typewriterCharsPerSecond: 30
